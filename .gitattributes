# Binary/source-document handling only.
# Website runtime delivery must not use Git LFS; large public/runtime files are
# published to Cloudflare R2 and referenced through runtime manifests.
*.pdf binary
*.xlsx binary
*.xls binary
*.json filter=lfs diff=lfs merge=lfs -text
processed_data/public_contracts/*.json filter=lfs diff=lfs merge=lfs -text
